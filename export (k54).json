scenario=># При старте системы
if onStart then {
  if Telegram then tg.sendMsg( "Контроллер K54 старт http://" + getIP() );
# Фикс для котлов Zota
#  boiler.command(2, 4);
# Фикс для котлов Ampera
# Используем весь доступный диапазон модуляции
#  boiler.command(14, 100);
# Передаем на котел комнатную температуру
#  boiler.command(24, Ds18b20_1);
# Передаем на котел заданную для термостата
#  boiler.command(16, set_id);
# присвоить коэффициенты EIK
  ThermostatETK.set_iv_k(ETKk);
  ThermostatETK2.set_iv_k(ETKk);
}

#Управление режимом работы котла(вкл/выкл СО и ГВС)
if BoilerEnable < 2 then boiler.SetBoilerStatus(BoilerEnable, 1, DHWenable, 0, 0, 0, 0, 0, 0);
if DHWenable < 2 then boiler.SetBoilerStatus(BoilerEnable, 1, DHWenable, 0, 0, 0, 0, 0, 0);

# Установка температуры отопления
if OTset1 then boiler.command(1, OTset1);
# Установка температуры ГВС
if OTset56 then boiler.command(56, OTset56);

# Задачи по таймеру
if timer == 0 then {
  # Режим работы котла
  boiler.SetBoilerStatus(BoilerEnable, 1, DHWenable, 0, 0, 0, 0, 0, 0);
  if setBoilerMAX < 35 then { setBoilerMAX = 35.0;}
  UpTime = getUptime();
}

# Сброс ошибки
if resetERR then {boiler.lockOutReset(); boiler.command(4, 256);}

# Задать коэффициент iv_k
if ETKk then {
  ThermostatETK.set_iv_k(ETKk);
  ThermostatETK2.set_iv_k(ETKk);
}

# Термостат GIST On
if GIST then { 
  ThermostatGIST.enable(1); 
  if rele then {
    if PID == 0 then { OTset1 = setBoilerMAX;}
    BoilerEnable = 1;}
} else { ThermostatGIST.enable(0);}

# Термостат GIST2 On
if GIST2 then {
  ThermostatGIST2.enable(1); 
  if rele2 then {
    if PID == 0 then { OTset1 = setBoilerMAX;}
    BoilerEnable = 1;}
} else { ThermostatGIST2.enable(0);}

# Термостаты GISTS Off
if GIST & GIST2 then {
  if rele == 0 & rele2 == 0 then {
    OTset1 = 35;
    if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}}
} else {
  if GIST & rele == 0 then {
    OTset1 = 35;
    if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}}
  if GIST2 & rele2 == 0 then {
    OTset1 = 35;
    if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}}
}

# Термостат ETK On
if ETK then {
  if ThermostatETK + ETKm > 35 then {
    if GIST | GIST2 then { setBoilerMAX = ThermostatETK + ETKm;
    } else { OTset1 = ThermostatETK + ETKm; BoilerEnable = 1;}
  } else {
    if GIST | GIST2 then { setBoilerMAX = 35.1;
    } else {
      OTset1 = 35;
      if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}}
  }
}

# Термостат ETK2 On
if ETK2 then {
  if ETK then { ETK = 0;}
  if ThermostatETK2 + ETKm > 35 then {
    if GIST | GIST2 then { setBoilerMAX = ThermostatETK2 + ETKm;
    } else { OTset1 = ThermostatETK2 + ETKm; BoilerEnable = 1;}
  } else {
    if GIST | GIST2 then { setBoilerMAX = 35.2;
    } else {
      OTset1 = 35;
      if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}}
  }
}

# Режим PID
if PID then { 
  ThermostatPID.enable(1); 
  if ETK | ETK2 then { ETK = 0; ETK2 = 0;}
  if PID_Kp > -1 then { ThermostatPID.KP(PID_Kp);}
  if PID_Ki > -1 then { ThermostatPID.KI(PID_Ki);}
  if PID_Kd > -1 then { ThermostatPID.KD(PID_Kd);}
  if setBoilerMAX > 35 then { ThermostatPID.setLimitsMAX(setBoilerMAX);}
  if ThermostatPID > 35 then {
    OTset1 = ThermostatPID; BoilerEnable = 1;
    if ThermostatETK2 + ETKm > 40 then {
      setBoilerMAX = ThermostatETK2 + ETKm;
    } else { setBoilerMAX = 40.3;}
  } else {
    OTset1 = 35;
    if ThermostatPID < 34.5 then {
      if GIST35 == 0 & vbtn_BCD == 0 then { BoilerEnable = 0;}
    }
  }
} else { ThermostatPID.enable(0); }

# Режим GIST35 исключает остановку котлового насоса зимой
if GIST35 then {
  if vbtn_BCD then { vbtn_BCD = 0;}
  if Ds18b20_1 < set_id + 0.1 then { BoilerEnable = 1;}
  if Ds18b20_1 > set_id + GIST0 & timer == 0 then {
      BoilerEnable = 0;
      if GIST & rele then { BoilerEnable = 1;}
      if GIST2 & rele2 then { BoilerEnable = 1;}
      if PID & ThermostatPID > 34.5 then { BoilerEnable = 1;}
      if ETK & ThermostatETK + ETKm > 34.5 then { BoilerEnable = 1;}
      if ETK2 & ThermostatETK2 + ETKm > 34.5 then { BoilerEnable = 1;}
  }
}

# Режим BCD исключает остывание тёплого пола летом
if vbtn_BCD then {
  if BCD > 1 then { timer_BCD.setInitCountDown(BCD);}
  if timer_BCD < 1 & Ds18b20_1 < AlarmHi then { BoilerEnable = 1;}
  if isHeatingEnabled == "✅" then {
    if timer_BCD < 1 & isFlameOn == "🔥работает" then { timer_BCD.reset();}
    if timer_BCD > 1 & timer_BCD < BCD - 2 & timer == 0 & BoilerEnable then {
      BoilerEnable = 0;
      if GIST & rele then { BoilerEnable = 1;}
      if GIST2 & rele2 then { BoilerEnable = 1;}
      if PID & ThermostatPID > 34.5 then { BoilerEnable = 1;}
      if ETK & ThermostatETK + ETKm > 34.5 then { BoilerEnable = 1;}
      if ETK2 & ThermostatETK2 + ETKm > 34.5 then { BoilerEnable = 1;}
    }
  }
}

# Форсаж ГВС
if timer_dhw_max == 0 then { 
    OTset56 = dhw_norm_temp;
    vbtn_dhw_max = 0;}
if vbtn_dhw_max then {
    OTset56 = 56.7;
    timer_dhw_max.reset();
} else {
    OTset56 = dhw_norm_temp;
    timer_dhw_max.stop();
}

